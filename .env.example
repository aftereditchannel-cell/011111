# ═══════════════════════════════════════════════════════════
#  نمونهٔ متغیرهای محیطی — نسخهٔ آیندهٔ ابری (Supabase)
#  ═══════════════════════════════════════════════════════════
#
#  نسخهٔ فعلی سایت کاملاً استاتیک است و به هیچ کلیدی نیاز ندارد.
#  این فایل فقط برای زمانی است که بخواهید Auth/DB را به Supabase
#  وصل کنید. مقدارها را در فایل `.env` بگذارید و هرگز آن را
#  Commit نکنید.

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# اختیاری — سرویس‌های رسانه
VITE_SOUNDCLOUD_CLIENT_ID=your-soundcloud-client-id
VITE_YOUTUBE_API_KEY=your-youtube-data-api-key

# نشانی عمومی سایت
VITE_SITE_URL=https://aftereditchannel-cell.github.io/011111
